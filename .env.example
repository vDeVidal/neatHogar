# ─── Copia este archivo como .env en la raíz (docker compose lo lee automáticamente) ───

# PostgreSQL
POSTGRES_USER=neathogar
POSTGRES_PASSWORD=neathogar_pass
POSTGRES_DB=neathogar
POSTGRES_PORT=5432

# API NestJS
API_PORT=3000
JWT_SECRET=cambia-este-secreto-en-produccion
# true = ejecuta el seed (idempotente) al iniciar el contenedor
SEED_DB=true

# Solo para desarrollo del backend fuera de Docker (backend/.env)
# DATABASE_URL=postgresql://neathogar:neathogar_pass@localhost:5432/neathogar?schema=public

# App móvil (mobile/.env) — opcional. Si no se define, la app detecta la IP LAN del servidor Expo.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api
